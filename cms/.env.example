# Supabase PostgreSQL — pooled connection for Prisma runtime queries
DATABASE_URL=

# Supabase PostgreSQL — direct connection for Prisma migrations
DIRECT_URL=

# NextAuth — random 32+ character string, signs JWT tokens
NEXTAUTH_SECRET=

# NextAuth — full CMS deployment URL e.g. https://cms.aman.dev
NEXTAUTH_URL=

# CMS login credentials — set once, never stored in DB
ADMIN_EMAIL= admin@gmail.com
ADMIN_PASSWORD_HASH=Shop@123

# Supabase project URL e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase service role key — used for storage writes, never exposed to client
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for revalidation webhook — min 32 chars random string
# Must match CMS_API_SECRET in the Portfolio .env
CMS_API_SECRET=

# Portfolio deployment URL — webhook target for ISR revalidation
PORTFOLIO_URL=

# Public portfolio URL — used in CMS editor "View on portfolio" links
NEXT_PUBLIC_PORTFOLIO_URL=
