# CMS deployment URL — all API fetches point here (no trailing slash)
# e.g. https://cms.aman.dev
NEXT_PUBLIC_CMS_URL=

# Shared secret — validates inbound revalidation webhooks from CMS
# Must match CMS_API_SECRET in the CMS .env
CMS_API_SECRET=

# Portfolio canonical URL — used in OG tags and sitemap
# e.g. https://aman.dev
NEXT_PUBLIC_SITE_URL=
